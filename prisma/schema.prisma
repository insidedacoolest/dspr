generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- DRIFT ----------

model Driver {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  num         String
  name        String
  nickname    String   @default("")
  role        String   @default("Driver")
  car         String
  engine      String   @default("")
  power       Int      @default(0)
  specs       String   @default("")
  bio         String   @default("")
  instagram   String   @default("")
  imageUrl    String?
  carImageUrl String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id        Int       @id @default(autoincrement())
  title     String
  location  String
  date      DateTime
  endDate   DateTime?
  kind      String    @default("comp")
  desc      String    @default("")
  result    String    @default("")
  link      String?
  createdAt DateTime  @default(now())
}

model NewsPost {
  id          Int      @id @default(autoincrement())
  title       String
  excerpt     String
  body        String   @default("")
  section     String   @default("drift")
  imageUrl    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String   @default("")
  section   String   @default("drift")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ---------- ABOUT ----------

model Milestone {
  id        Int      @id @default(autoincrement())
  year      String
  title     String
  text      String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- GARAGE ----------

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  priceFrom   Float?
  duration    String   @default("")
  icon        String   @default("wrench")
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  phone         String
  car           String
  service       String   @default("")
  preferredDate String   @default("")
  message       String   @default("")
  status        String   @default("new")
  adminNotes    String   @default("")
  createdAt     DateTime @default(now())
}

// ---------- SHOP ----------

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  description  String   @default("")
  section      String   @default("merch")
  category     String   @default("")
  brand        String   @default("")
  sku          String   @default("")
  fitment      String   @default("")
  price        Float
  oldPrice     Float?
  sizesCsv     String?
  variantsJson String   @default("[]")
  inStock      Boolean  @default(true)
  featured     Boolean  @default(false)
  imageUrl     String?
  imagesJson   String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id              Int         @id @default(autoincrement())
  name            String
  email           String
  phone           String
  address         String
  city            String      @default("")
  state           String      @default("")
  zip             String      @default("")
  country         String      @default("US")
  delivery        String      @default("ship")
  notes           String      @default("")
  status          String      @default("awaiting_payment")
  subtotal        Float       @default(0)
  shipping        Float       @default(0)
  total           Float
  paymentMethod   String      @default("")
  paypalOrderId   String?
  paypalCaptureId String?
  paidAt          DateTime?
  emailsSentAt    DateTime?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  productName String
  size        String?
  price       Float
  qty         Int
}

// ---------- GENERAL ----------

model Partner {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String?
  link      String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

model AdminUser {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
}
